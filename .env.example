# Copy this file to .env and fill in the values (never commit .env).
# .env is listed in .gitignore, so it is never uploaded to GitHub.

# An EXISTING edX account email, used by TC-R05 ("email already registered").
EDX_VALID_EMAIL=group4.test.account@example.com

# Base inbox for NEW accounts. Each run creates one account at
#   <name>+edxqa<date-time>@<domain>  (e.g. group4+edxqa261126235501@gmail.com)
# which Gmail/Outlook deliver to the base inbox. Leave empty to reuse EDX_VALID_EMAIL.
EDX_SIGNUP_EMAIL=
# Password given to each new test account (8+ characters, a letter and a number).
EDX_SIGNUP_PASSWORD=change-me-2026

# Optional
HEADLESS=0
EDX_WAIT_SECONDS=15
